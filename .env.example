# ── Supabase (client / browser) ──────────────────────────────
# Safe to expose. Used by the SPA with Row Level Security enforced.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# LiveKit websocket URL (client build + optional server fallback).
# e.g. wss://your-project.livekit.cloud — required on Vercel for /room pages.
VITE_LIVEKIT_URL=

# Show the seed-data dashboard chooser on /login even when Supabase is configured.
# Useful for production reviewers. Set to true on Vercel for demo deployments.
VITE_DEMO_LOGIN=

# reCAPTCHA v3 site key (client). Get a key pair at
# https://www.google.com/recaptcha/admin (choose "reCAPTCHA v3").
# When empty, the contact form submits without a captcha check.
VITE_RECAPTCHA_SITE_KEY=

# ── Server-only (Vercel serverless / local Express) ──────────
# NEVER expose these to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# LiveKit URL for token API (recommended on Vercel; can duplicate VITE_LIVEKIT_URL).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Max people per room (2–12 recommended). Defaults to 12.
LIVEKIT_MAX_PARTICIPANTS=12

# Room recording (LiveKit Egress → S3 or LiveKit Cloud default storage).
# Option A: explicit S3-compatible bucket (AWS S3, Cloudflare R2, etc.)
LIVEKIT_EGRESS_S3_BUCKET=
LIVEKIT_EGRESS_S3_ACCESS_KEY=
LIVEKIT_EGRESS_S3_SECRET=
LIVEKIT_EGRESS_S3_REGION=us-east-1
# Optional custom endpoint for R2/MinIO, e.g. https://<account>.r2.cloudflarestorage.com
LIVEKIT_EGRESS_S3_ENDPOINT=
# Option B: use default storage configured in LiveKit Cloud dashboard
LIVEKIT_EGRESS_USE_CLOUD_STORAGE=

# reCAPTCHA v3 secret key (server). Pairs with VITE_RECAPTCHA_SITE_KEY.
# When empty, the contact API skips verification (local/demo friendly).
RECAPTCHA_SECRET_KEY=
# Minimum passing score (0.0–1.0). Defaults to 0.5.
RECAPTCHA_MIN_SCORE=0.5

# Resend transactional email
RESEND_API_KEY=
EMAIL_FROM="Practical Drumming <hello@example.com>"

# Public base URL used inside emails (booking/join links).
PUBLIC_BASE_URL=http://localhost:5173

# Local API dev server
API_PORT=3003
