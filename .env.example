# ── Supabase (client / browser) ──────────────────────────────
# Safe to expose. Used by the SPA with Row Level Security enforced.
# Use Project URL + either the legacy anon JWT or the new publishable key
# (Dashboard → Settings → API).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Supabase Storage (LiveKit recording uploads + vault playback) ──
# Create an S3 access key pair in Supabase Dashboard → Storage → S3 Connection.
SUPABASE_STORAGE_BUCKET=session-recordings
SUPABASE_STORAGE_S3_ACCESS_KEY=
SUPABASE_STORAGE_S3_SECRET_KEY=
SUPABASE_STORAGE_S3_REGION=us-east-1
# Optional — auto-derived from SUPABASE_URL if omitted:
# SUPABASE_STORAGE_S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
# Set true only if the bucket is public (see supabase/storage.sql):
# SUPABASE_STORAGE_PUBLIC=false

# LiveKit websocket URL (client build + optional server fallback).
# e.g. wss://your-project.livekit.cloud — required on Vercel for /room pages.
VITE_LIVEKIT_URL=

# Show the seed-data dashboard chooser on /login even when Supabase is configured.
# Useful for production reviewers. Set to true on Vercel for demo deployments.
VITE_DEMO_LOGIN=

# reCAPTCHA v3 site key (client). Get a key pair at
# https://www.google.com/recaptcha/admin (choose "reCAPTCHA v3").
# When empty, the contact form submits without a captcha check.
VITE_RECAPTCHA_SITE_KEY=

# ── Server-only (Vercel serverless / local Express) ──────────
# NEVER expose these to the browser.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LiveKit URL for token API (recommended on Vercel; can duplicate VITE_LIVEKIT_URL).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Max people per room (2–12 recommended). Defaults to 12.
LIVEKIT_MAX_PARTICIPANTS=12

# Room recording (LiveKit Egress → Supabase Storage S3 API or other S3-compatible store).
# Prefer SUPABASE_STORAGE_S3_* above; these aliases still work:
LIVEKIT_EGRESS_S3_BUCKET=
LIVEKIT_EGRESS_S3_ACCESS_KEY=
LIVEKIT_EGRESS_S3_SECRET=
LIVEKIT_EGRESS_S3_REGION=us-east-1
LIVEKIT_EGRESS_S3_ENDPOINT=
# Fallback: LiveKit Cloud default bucket (skip Supabase Storage):
LIVEKIT_EGRESS_USE_CLOUD_STORAGE=

# reCAPTCHA v3 secret key (server). Pairs with VITE_RECAPTCHA_SITE_KEY.
# When empty, the contact API skips verification (local/demo friendly).
RECAPTCHA_SECRET_KEY=
# Minimum passing score (0.0–1.0). Defaults to 0.5.
RECAPTCHA_MIN_SCORE=0.5

# Resend transactional email
RESEND_API_KEY=
EMAIL_FROM="Practical Drumming <admin@pracdrum.com>"
ADMIN_EMAIL=admin@example.com

# Public base URL used inside emails (booking/join links).
PUBLIC_BASE_URL=http://localhost:5173

# Local API dev server
API_PORT=3003
