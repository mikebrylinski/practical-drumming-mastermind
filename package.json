{
  "name": "practical-drumming-mastermind",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:client": "vite",
    "dev:api": "node --env-file-if-exists=.env server/index.js",
    "check:supabase": "node --env-file-if-exists=.env scripts/check-supabase.mjs",
    "check:storage": "node --env-file-if-exists=.env scripts/check-storage.mjs",
    "check:resend": "node --env-file-if-exists=.env scripts/check-resend.mjs",
    "setup:platform": "node --env-file-if-exists=.env scripts/apply-platform-migration.mjs",
    "setup:contacts": "node --env-file-if-exists=.env scripts/apply-contacts-migration.mjs",
    "seed:cohorts": "node --env-file-if-exists=.env scripts/seed-cohort-sessions.mjs",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@livekit/components-react": "^2.9.21",
    "@livekit/components-styles": "^1.2.0",
    "@supabase/supabase-js": "^2.106.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "framer-motion": "^12.38.0",
    "livekit-client": "^2.19.1",
    "livekit-server-sdk": "^2.15.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.0",
    "resend": "^6.12.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "pg": "^8.21.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
